# Скопируйте в .env и заполните:
#   cp .env.example .env
#
# Затем:
#   docker compose up --build
#
# Без TELEGRAM_WEBHOOK_URL бот работает через long polling (туннель не нужен).

# --- обязательно для бота ---
TELEGRAM_TOKEN=

# --- LLM ---
# true = без ключа (mock); false = нужен LLM_API_KEY (Groq)
LLM_MOCK=true
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1

# --- панель главы семьи ---
ADMIN_USER=admin
ADMIN_PASS=admin

# --- опционально: webhook (публичный HTTPS) ---
# TELEGRAM_WEBHOOK_URL=https://your.host/telegram/webhook

# --- курсы (копейки BYN за 1 единицу валюты) ---
# USD_TO_BYN_KOPECKS=300
# RUB_TO_BYN_KOPECKS=4
